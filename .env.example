# ============================================
# PRODUCTION ENV — docker-compose.prod.yml
# Copy file nay: cp .env.example .env
# Roi dien cac gia tri thuc
# ============================================

# MySQL
MYSQL_ROOT_PASSWORD=CHANGE_ME
MYSQL_PASSWORD=CHANGE_ME

# JWT (tao bang: openssl rand -hex 32)
JWT_SECRET=CHANGE_ME

# Cloudflare R2
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY=CHANGE_ME
R2_SECRET_KEY=CHANGE_ME

# Resend (Email)
RESEND_API_KEY=re_xxxxx

# Contact
SUPPORT_PHONE=0123456789
ADMIN_EMAILS=admin@yourdomain.com

# Cron (tao bang: openssl rand -hex 16)
CRON_SECRET=CHANGE_ME

# Cloudflare Tunnel (de trong neu dung SSL truc tiep)
CLOUDFLARE_TUNNEL_TOKEN=
