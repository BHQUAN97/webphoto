# ============================================
# PRODUCTION ENV — docker-compose.prod.yml
# Copy file nay: cp .env.example .env
# Roi dien cac gia tri thuc
# ============================================

# MySQL
MYSQL_ROOT_PASSWORD=CHANGE_ME
MYSQL_PASSWORD=CHANGE_ME

# JWT (tao bang: openssl rand -hex 32)
JWT_SECRET=CHANGE_ME

# Cloudflare R2
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY=CHANGE_ME
R2_SECRET_KEY=CHANGE_ME

# Resend (Email)
RESEND_API_KEY=re_xxxxx

# Contact
SUPPORT_PHONE=0123456789
ADMIN_EMAILS=admin@yourdomain.com

# Cron (tao bang: openssl rand -hex 16)
CRON_SECRET=CHANGE_ME

# Cloudflare Tunnel (de trong neu dung SSL truc tiep)
CLOUDFLARE_TUNNEL_TOKEN=

# ============================================
# Google Drive Backup — scripts/backup-gdrive.*
# ============================================
# Bat/tat upload backup len Google Drive
GDRIVE_ENABLED=false
# Duong dan file JSON service account (xem scripts/.gdrive-credentials.example.json)
GDRIVE_CREDENTIALS_PATH=./scripts/.gdrive-credentials.json
# Folder ID tren Google Drive (lay tu URL: drive.google.com/drive/folders/<ID>)
GDRIVE_FOLDER_ID=
# Ten subfolder trong folder chinh
GDRIVE_DB_SUBFOLDER=database
GDRIVE_UPLOADS_SUBFOLDER=media
# So ban backup giu lai (xoa cu hon)
GDRIVE_KEEP_COUNT=14
# Thu muc chua backup MySQL (de tim file .sql.gz moi nhat)
BACKUP_DIR=/opt/webphoto/backups
# Thu muc uploads se zip va upload
UPLOADS_DIR=./photo-storage/server/data/storage
