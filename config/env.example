# ============================================
# WebPhoto Production Config
# Copy thanh config/env va dien gia tri that
# ============================================

# -- VPS (SSH) --
VPS_HOST=your-vps-ip
VPS_PORT=22
VPS_USER=root
VPS_PASSWORD=change-me

# -- API --
API_URL=https://your-domain.com

# -- MySQL --
MYSQL_ROOT_PASSWORD=change-me
MYSQL_PASSWORD=change-me

# -- JWT --
JWT_SECRET=change-me-use-openssl-rand-hex-32

# -- Cloudflare R2 --
R2_ENDPOINT=https://your-account.r2.cloudflarestorage.com
R2_ACCESS_KEY=change-me
R2_SECRET_KEY=change-me
CDN_URL=

# -- Resend (Email) --
RESEND_API_KEY=re_change_me

# -- Contact --
SUPPORT_PHONE=0123456789
ADMIN_EMAILS=admin@your-domain.com

# -- Cron --
CRON_SECRET=change-me-use-openssl-rand-hex-32

# -- Backup encryption --
# Key de encrypt backup truoc khi push len Git (openssl rand -hex 32)
BACKUP_ENCRYPT_KEY=change-me-use-openssl-rand-hex-32

# -- Cloudflare Tunnel (optional) --
CLOUDFLARE_TUNNEL_TOKEN=
