# Server
PORT=4000
NODE_ENV=development

# Database — MySQL 8
DATABASE_URL=mysql://root:password@localhost:3306/photo_storage

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-secret-key-change-in-production

# Cloudflare R2
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY=your-r2-access-key
R2_SECRET_KEY=your-r2-secret-key
R2_PRIVATE_BUCKET=raw-private
R2_PUBLIC_BUCKET=serve-public
R2_LIMIT_GB=10
CDN_URL=https://your-cdn.example.com

# Resend (Email)
RESEND_API_KEY=re_xxxxx
FROM_EMAIL=noreply@example.com
ADMIN_EMAILS=admin@example.com

# App
APP_NAME=PhotoStorage
APP_URL=http://localhost:3000
APP_ADDRESS=
SUPPORT_PHONE=0123456789
SUPPORT_EMAIL=support@example.com

# Socket.io
SOCKET_PORT=4001

# CORS
CORS_ORIGIN=http://localhost:3000

# Cron
CRON_SECRET=your-cron-secret-here

# Cloudflare Tunnel (optional — for tunnel deployment mode)
CLOUDFLARE_TUNNEL_TOKEN=
