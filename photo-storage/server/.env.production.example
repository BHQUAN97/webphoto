# ============================================
# PHOTO STORAGE — PRODUCTION ENV
# Copy sang .env và điền thông tin thật
# ============================================

# Server
PORT=4000
NODE_ENV=production

# Database — PlanetScale hoặc Railway MySQL
DATABASE_URL=mysql://user:pass@host:3306/photo_storage?ssl={"rejectUnauthorized":true}

# Redis — Upstash
REDIS_URL=rediss://default:token@host.upstash.io:6379

# JWT — tạo random: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_TO_RANDOM_64_CHAR_HEX

# Cloudflare R2
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY=your-r2-access-key
R2_SECRET_KEY=your-r2-secret-key
R2_PRIVATE_BUCKET=photo-raw-private
R2_PUBLIC_BUCKET=photo-serve-public
R2_LIMIT_GB=10
CDN_URL=https://cdn.yourdomain.com

# Email — Resend
RESEND_API_KEY=re_xxxxx
FROM_EMAIL=noreply@yourdomain.com

# App
APP_NAME=PhotoStorage
APP_URL=https://app.yourdomain.com
APP_ADDRESS=Vietnam
SUPPORT_PHONE=0123456789
SUPPORT_EMAIL=support@yourdomain.com

# Admin email (nhận thông báo đơn hàng)
ADMIN_EMAILS=admin@yourdomain.com

# CORS — URL frontend
CORS_ORIGIN=https://app.yourdomain.com

# Socket.io
SOCKET_PORT=4001

# Cron — tạo random: openssl rand -hex 16
CRON_SECRET=CHANGE_ME_TO_RANDOM_STRING
