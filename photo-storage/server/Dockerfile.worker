FROM node:20-slim

# Install dcraw + sharp native dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    dcraw \
    libraw-bin \
    libvips-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm ci --omit=dev

COPY dist/ ./dist/

ENV NODE_ENV=production

# Worker entry — starts BullMQ workers only (no HTTP server)
CMD ["node", "dist/workers/start.js"]
